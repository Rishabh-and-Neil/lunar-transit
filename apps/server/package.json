{
  "name": "@sm/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --packages=external --alias:@sm/shared=../../packages/shared/src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": { "@sm/shared": "1.0.0", "socket.io": "4.8.1", "zod": "3.23.8" },
  "devDependencies": { "@types/node": "22.9.0", "esbuild": "0.24.0", "tsx": "4.19.2", "socket.io-client": "4.8.1" }
}
